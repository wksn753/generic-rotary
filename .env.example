# Go backend registration endpoint
REGISTRATION_API_URL=http://localhost:8080/api/register
# Optional explicit backend root used by the expanded admin operations proxy.
REGISTRATION_BACKEND_ROOT_URL=http://localhost:8080/api

# Existing admin login/session
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_SESSION_HOURS=8

# Must match the Go backend ADMIN_API_KEY in production.
ADMIN_API_KEY=replace-with-the-same-backend-admin-key

# Optional legacy endpoint overrides
REGISTRATION_LOOKUP_API_URL=http://localhost:8080/api/visitors/lookup
REGISTRATION_ATTENDANCE_API_URL=http://localhost:8080/api/attendance
